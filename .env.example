# ------------------------------------------------------------------
# AUXOIS INTENDANCE — variables de configuration
# Copiez ce fichier en « .env.local » (en local) ou saisissez chaque
# ligne dans les « Environment Variables » de votre hébergeur (Vercel).
# ------------------------------------------------------------------

# 1. Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé « service_role » : SECRÈTE, jamais dans le navigateur. Sert à créer les
# comptes, installer la démonstration et expédier les notifications.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 2. Adresse publique de l’application (liens dans les emails)
NEXT_PUBLIC_APP_URL=https://auxois-intendance.vercel.app

# 3. Notifications push (générer une fois avec : npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@votre-domaine.fr

# 4. Emails (facultatif) — compte Resend : https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Auxois Intendance <notifications@votre-domaine.fr>"

# 5. Tâche planifiée d’expédition des notifications (une chaîne secrète au hasard)
CRON_SECRET=

# 6. Facultatif : code demandé par l’assistant d’installation (protège la
#    création du premier compte administrateur juste après le déploiement)
SETUP_SECRET=
